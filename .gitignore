/target
/spikes/**/target

# Where .github/workflows/release.yml stages and zips the release archive. It only ever
# exists on a runner, but a local run of those steps should not leave a committable binary.
/dist
**/*.rs.bk
*.pdb

# Diagnostic captures. The debug-only LEXISWITCH_DIAG output prints keystroke content, and
# redirecting it to a file is how something derived from typing ends up on disk — which
# ADR-0005 forbids outright. Ignored so a captured session cannot be committed by accident;
# delete these rather than keeping them.
diag*.txt
*.diag

.claude
CLAUDE.md

# Local editor / OS noise
# `*~lock~` is Affinity's lock file, which appears beside the icon sources in media/ while
# they are open. The sources themselves are tracked — lexiswitch/build.rs reads the .ico.
*~lock~
.vscode/
.idea/
Thumbs.db
desktop.ini
